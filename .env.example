# PostgreSQL (Neon / local). Пример Neon:
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Сессии (любая длинная случайная строка)
JWT_SECRET="change-me-to-random-secret"

# Telegram
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_BOT_USERNAME="dota5v5_mygroup_bot"
TELEGRAM_WEBHOOK_SECRET=""
ADMIN_TELEGRAM_IDS=""
# Cloudflare Worker proxy (если VPS плохо ходит в api.telegram.org)
# TELEGRAM_API_BASE="https://startplus-tg-proxy.<account>.workers.dev"
# TELEGRAM_PROXY_SECRET="long-random-secret"

# Twitch (опционально; без ключей — fallback через decapi.me)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# URL приложения (локально или https://ваш-проект.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Локальные загрузки на VPS (по умолчанию public/uploads или /var/www/startplus/uploads)
# UPLOADS_DIR="/var/www/startplus/uploads"
# BLOB больше не используется на self-host.


# Cron (опционально, для /api/cron/automation)
CRON_SECRET=""

# LiveKit voice (self-hosted). Browser URL + API keys.
# LIVEKIT_URL=wss://www.startdota.ru:8443
# LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret-at-least-32-chars-long!!!!

