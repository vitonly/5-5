# PostgreSQL (Neon / local). Пример Neon:
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Сессии (любая длинная случайная строка)
JWT_SECRET="change-me-to-random-secret"

# Telegram
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_BOT_USERNAME="dota5v5_mygroup_bot"
TELEGRAM_WEBHOOK_SECRET=""
ADMIN_TELEGRAM_IDS=""

# Twitch (опционально; без ключей — fallback через decapi.me)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# URL приложения (локально или https://ваш-проект.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob — обязателен в production для аватаров и файлов домашек
# Создаётся в Vercel → Storage → Blob
BLOB_READ_WRITE_TOKEN=""

# Cron (опционально, для /api/cron/automation)
CRON_SECRET=""
